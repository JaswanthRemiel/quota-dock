<Application x:Class="QuotaDock.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Windows 11 Fluent Dark Colors -->
            <SolidColorBrush x:Key="BackgroundBrush" Color="#1E1E1E" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#2D2D2D" />
            <SolidColorBrush x:Key="BorderBrush" Color="#3E3E3E" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A0A0A0" />
            <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#107C41" />
            <SolidColorBrush x:Key="WarningBrush" Color="#D83B01" />
            <SolidColorBrush x:Key="CriticalBrush" Color="#E81123" />
            
            <FontFamily x:Key="FluentFont">Segoe UI Variable Display, Segoe UI, sans-serif</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
