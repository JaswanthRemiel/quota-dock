<Window x:Class="QuotaDock.Windows.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuotaDock"
        Height="480"
        Width="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Deactivated="Window_Deactivated">

    <Border Background="#1C1C1E"
            BorderBrush="#38383A"
            BorderThickness="1"
            CornerRadius="12"
            Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.5"/>
        </Border.Effect>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Status Pill -->
                <RowDefinition Height="*"/>    <!-- Quota Cards -->
                <RowDefinition Height="Auto"/> <!-- Footer / Velocity -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="16" Margin="0,0,8,0"/>
                    <TextBlock Text="QuotaDock" FontWeight="Bold" FontSize="16" Foreground="#FFFFFF" FontFamily="{StaticResource FluentFont}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Width="24" Height="24" Background="Transparent" Foreground="#8E8E93" BorderThickness="0" Click="CloseButton_Click" Cursor="Hand"/>
            </Grid>

            <!-- Status Pill & Mode -->
            <Border Grid.Row="1" Background="#2C2C2E" CornerRadius="8" Padding="10,8" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="10" Height="10" Fill="#30D158" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Gateway Active (127.0.0.1:8080)" FontSize="12" Foreground="#E5E5EA" VerticalAlignment="Center" FontFamily="{StaticResource FluentFont}"/>
                    <TextBlock Grid.Column="2" Text="Auto-Failover ON" FontSize="11" Foreground="#0A84FF" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Provider Quota Cards -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Anthropic -->
                    <Border Background="#252527" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <TextBlock Text="Anthropic Claude 3.5" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="13"/>
                                <TextBlock Text="88% Remaining" HorizontalAlignment="Right" Foreground="#30D158" FontSize="12" FontWeight="SemiBold"/>
                            </Grid>
                            <ProgressBar Grid.Row="1" Value="88" Maximum="100" Height="6" Margin="0,8,0,0" Foreground="#30D158" Background="#3A3A3C" BorderThickness="0"/>
                        </Grid>
                    </Border>

                    <!-- OpenAI -->
                    <Border Background="#252527" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <TextBlock Text="OpenAI GPT-4o" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="13"/>
                                <TextBlock Text="74% Remaining" HorizontalAlignment="Right" Foreground="#30D158" FontSize="12" FontWeight="SemiBold"/>
                            </Grid>
                            <ProgressBar Grid.Row="1" Value="74" Maximum="100" Height="6" Margin="0,8,0,0" Foreground="#30D158" Background="#3A3A3C" BorderThickness="0"/>
                        </Grid>
                    </Border>

                    <!-- Google Gemini -->
                    <Border Background="#252527" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <TextBlock Text="Google Gemini 1.5 Pro" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="13"/>
                                <TextBlock Text="95% Remaining" HorizontalAlignment="Right" Foreground="#30D158" FontSize="12" FontWeight="SemiBold"/>
                            </Grid>
                            <ProgressBar Grid.Row="1" Value="95" Maximum="100" Height="6" Margin="0,8,0,0" Foreground="#30D158" Background="#3A3A3C" BorderThickness="0"/>
                        </Grid>
                    </Border>

                    <!-- Ollama (Local) -->
                    <Border Background="#252527" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <TextBlock Text="Ollama Local (Fallback)" FontWeight="SemiBold" Foreground="#FFFFFF" FontSize="13"/>
                                <TextBlock Text="Ready (Offline)" HorizontalAlignment="Right" Foreground="#0A84FF" FontSize="12" FontWeight="SemiBold"/>
                            </Grid>
                            <ProgressBar Grid.Row="1" Value="100" Maximum="100" Height="6" Margin="0,8,0,0" Foreground="#0A84FF" Background="#3A3A3C" BorderThickness="0"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer: Live Telemetry & Quick Action -->
            <Border Grid.Row="3" Background="#242426" CornerRadius="8" Padding="10,8" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Token Velocity: 42.5k / min" FontSize="11" Foreground="#8E8E93" FontFamily="{StaticResource FluentFont}"/>
                        <TextBlock Text="Failovers Prevented: 14" FontSize="11" Foreground="#30D158" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Open Dashboard" Background="#0A84FF" Foreground="#FFFFFF" BorderThickness="0" Padding="8,4" FontWeight="SemiBold" FontSize="11" Cursor="Hand" Click="DashboardButton_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
